# ─────────────────────────────────────────
# LOCAL DEVELOPMENT (Default)
# Uses local SQLite file in prisma/dev.db
# ─────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────
# PRODUCTION ON VERCEL (Turso / libSQL)
# When deployed to Vercel, set these Environment Variables:
# 1. TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# 2. TURSO_AUTH_TOKEN="your-turso-auth-token"
# ─────────────────────────────────────────
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
